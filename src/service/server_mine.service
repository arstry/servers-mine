[Unit]
Description=Mine Server
Requires=tailscaled.service
After=network.target tailscaled.service

[Service]
Type=forking
User=arstry
Group=arstry
WorkingDirectory=/opt/server-mine/src/modpack

ExecStart=/usr/bin/tmux new-session -d -s mine-server '/usr/local/bin/mise exec -- ./run.sh'

ExecStop=/usr/bin/tmux send-keys -t mine-server:0 "stop" C-m
ExecStop=/usr/bin/sleep 20

Restart=on-failure

[Install]
WantedBy=multi-user.target
