# Copy to .env and adjust. Read by docker-compose.yml.

# Java major version used to build the image (eclipse-temurin tag)
JAVA_VERSION=17

# Host port mapped to the server
MC_PORT=25565

# Container user ids — match your host user (`id -u` / `id -g`)
# so files in minecraft/args stay owned by you
PUID=1000
PGID=1000
